# Load balancer URL for all REST API calls (local or Render)
VITE_LOAD_BALANCER_URL=http://localhost:8081

# Socket.IO connects directly to one backend (not through the load balancer).
# Local backend: http://localhost:5000
# Remote backend (when LB uses Render and no local backend is running):
VITE_SOCKET_URL=https://jntuh-backend.onrender.com
