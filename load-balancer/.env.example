# Backend Render URLs (no trailing slash)
BACKEND_1_URL=https://jntuh-backend.onrender.com
BACKEND_2_URL=https://jntuh-backend-lzw7.onrender.com


# Optional: health poll interval in milliseconds (default 15000)
HEALTH_CHECK_INTERVAL_MS=15000

# Optional: primary health path (falls back to /api/ping if 404)
HEALTH_CHECK_PATH=/health

# Render sets PORT automatically in production
# Use 8081 locally if 8080 is taken (e.g. by Jenkins)
PORT=8081
